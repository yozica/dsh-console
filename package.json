{
  "name": "dsh-console",
  "productName": "DSH Console",
  "version": "0.6.0",
  "private": true,
  "description": "Desktop console for DeepSeek Harness (Windows / macOS): start/stop dsh, monitor its service health, and watch it in a real terminal.",
  "main": "dist/main/main.js",
  "license": "MIT",
  "author": {
    "name": "yozica",
    "url": "https://github.com/yozica"
  },
  "homepage": "https://github.com/yozica/dsh-console",
  "repository": {
    "type": "git",
    "url": "https://github.com/yozica/dsh-console.git"
  },
  "bugs": {
    "url": "https://github.com/yozica/dsh-console/issues"
  },
  "scripts": {
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:sandbox": "tsx scripts/build.mts",
    "start": "npm run build && electron .",
    "watch": "vite build --watch",
    "watch:main": "tsc -p tsconfig.main.json --watch",
    "test": "tsx test/selftest.ts",
    "changeset": "changeset add",
    "release:check": "changeset status --since=origin/main",
    "release:prepare": "tsx tools/release-prepare.mts",
    "typecheck": "npm run typecheck:main && npm run typecheck:renderer && npm run typecheck:node",
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit",
    "typecheck:renderer": "vue-tsc -p tsconfig.renderer.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "pack:win": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win",
    "pack:mac": "npm run build && electron-builder --mac --dir",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-pty": "1.2.0-beta.15"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@lobehub/icons-static-png": "^1.75.0",
    "@types/node": "^24.13.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vue": "^3.5.42",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "allowScripts": [
    "electron",
    "node-pty",
    "esbuild"
  ],
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "build": {
    "appId": "com.dsh.console",
    "productName": "DSH Console",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "yozica",
        "repo": "dsh-console"
      }
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*",
      "!**/*.map",
      "!**/*.md",
      "!**/test/**",
      "!**/tests/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "DSH.Console.Setup.${version}.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true,
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "DSH.Console-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "DSH Console ${version}",
      "artifactName": "DSH.Console-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "DSH.Console.${version}.${ext}"
    }
  }
}
